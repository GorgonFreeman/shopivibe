{% liquid
  assign limit = section.settings.limit | default: 10
  if limit > 10
    assign limit = 10
  endif
  if limit < 4
    assign limit = 4
  endif
  assign intent = 'related'
%}

<section
  class="recommendations-section"
  aria-labelledby="recommendations-heading-{{ section.id }}"
>
  {% if product %}
    {% if intent == 'complementary' %}
      <h2 class="recommendations-section__heading" id="recommendations-heading-{{ section.id }}">
        {{ 'sections.recommendations.heading_complementary' | t }}
      </h2>
    {% else %}
      <h2 class="recommendations-section__heading" id="recommendations-heading-{{ section.id }}">
        {{ 'sections.recommendations.heading_related' | t }}
      </h2>
    {% endif %}
  {% else %}
    <h2 class="recommendations-section__heading" id="recommendations-heading-{{ section.id }}">
      {{ 'sections.recommendations.heading_related' | t }}
    </h2>
  {% endif %}

  <div
    class="product-recommendations"
    {% if product %}
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ intent }}"
    {% endif %}
  >
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      <div
        class="recommendations-carousel"
        data-carousel
      >
        <div
          class="recommendations-carousel__track"
          data-carousel-track
          role="list"
        >
          {%- for recommended_product in recommendations.products -%}
            <div class="recommendations-carousel__slide" role="listitem">
              {% render 'product_tile', product: recommended_product %}
            </div>
          {%- endfor -%}
        </div>

        <div class="recommendations-carousel__nav">
          <button
            type="button"
            class="recommendations-carousel__btn"
            aria-label="{{ 'sections.recommendations.previous' | t }}"
            data-carousel-prev
          >
            ‹
          </button>
          <button
            type="button"
            class="recommendations-carousel__btn"
            aria-label="{{ 'sections.recommendations.next' | t }}"
            data-carousel-next
          >
            ›
          </button>
        </div>
      </div>
    {%- elsif product == blank -%}
      <p class="recommendations-section__empty">
        {{ 'sections.recommendations.no_product_context' | t }}
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .product-recommendations {
    min-height: 1px;
  }

  .recommendations-carousel {
    position: relative;
  }

  .recommendations-carousel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline-start: 2.75rem;
    scroll-padding-inline-end: 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    padding-bottom: 0.25rem;
    overscroll-behavior-x: contain;
  }

  .recommendations-carousel__slide {
    flex: 0 0 min(85vw, 18rem);
    scroll-snap-align: start;
    scroll-margin-inline-start: 0;
    scroll-margin-inline-end: 0;
  }

  .recommendations-carousel__slide:first-child {
    scroll-margin-inline-start: 2.75rem;
  }

  .recommendations-carousel__slide:last-child {
    scroll-margin-inline-end: 0;
  }

  .recommendations-carousel__slide product-tile {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .recommendations-carousel__nav {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .recommendations-carousel__btn[data-carousel-prev] {
    position: absolute;
    left: 0.35rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .recommendations-carousel__btn[data-carousel-next] {
    position: absolute;
    right: 0.35rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .recommendations-carousel__btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0;
    border-radius: 9999px;
    border: 1px solid rgb(0 0 0 / 12%);
    background: rgb(255 255 255 / 92%);
    box-shadow: 0 1px 3px rgb(0 0 0 / 12%);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    color: #222;
  }

  .recommendations-carousel__btn:hover {
    border-color: rgb(0 0 0 / 22%);
    background: #fff;
    box-shadow: 0 2px 6px rgb(0 0 0 / 14%);
  }

  .recommendations-carousel__btn:focus-visible {
    outline: 2px solid #222;
    outline-offset: 2px;
  }
{% endstylesheet %}

{% javascript %}
  function bindRecommendationsCarousel(container) {
    var track = container.querySelector('[data-carousel-track]');
    var prevBtn = container.querySelector('[data-carousel-prev]');
    var nextBtn = container.querySelector('[data-carousel-next]');
    if (!track || !prevBtn || !nextBtn) {
      return;
    }

    function slides() {
      return Array.prototype.slice.call(track.querySelectorAll('.recommendations-carousel__slide'));
    }

    var controlIndex = 0;
    var scrollSyncTimer = null;

    function indexClosestToScrollLeft() {
      var items = slides();
      if (!items.length) {
        return 0;
      }
      var x = track.scrollLeft;
      var best = 0;
      var bestDist = Infinity;
      for (var i = 0; i < items.length; i++) {
        var d = Math.abs(items[i].offsetLeft - x);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      }
      return best;
    }

    function syncControlIndexFromScroll() {
      controlIndex = indexClosestToScrollLeft();
    }

    function updateNavVisibility() {
      var items = slides();
      var len = items.length;
      if (!len) {
        prevBtn.hidden = true;
        nextBtn.hidden = true;
        return;
      }
      prevBtn.hidden = controlIndex <= 0;
      nextBtn.hidden = controlIndex >= len - 1;
    }

    function goToIndex(i) {
      var items = slides();
      if (!items.length) {
        return;
      }
      var clamped = Math.max(0, Math.min(items.length - 1, i));
      controlIndex = clamped;
      var scrollPaddingStart =
        parseFloat(window.getComputedStyle(track).scrollPaddingInlineStart || '0') || 0;
      var targetLeft = Math.max(0, items[clamped].offsetLeft - scrollPaddingStart);
      track.scrollTo({ left: targetLeft, behavior: 'smooth' });
      updateNavVisibility();
    }

    track.addEventListener(
      'scroll',
      function () {
        if (scrollSyncTimer) {
          window.clearTimeout(scrollSyncTimer);
        }
        scrollSyncTimer = window.setTimeout(function () {
          scrollSyncTimer = null;
          syncControlIndexFromScroll();
          updateNavVisibility();
        }, 60);
      },
      { passive: true },
    );

    syncControlIndexFromScroll();
    updateNavVisibility();

    prevBtn.onclick = function () {
      goToIndex(controlIndex - 1);
    };

    nextBtn.onclick = function () {
      goToIndex(controlIndex + 1);
    };
  }

  function parseRecommendationsFromResponse(text) {
    var doc = new DOMParser().parseFromString(text, 'text/html');
    var fromDoc = doc.querySelector('.product-recommendations');
    if (fromDoc) {
      return fromDoc;
    }
    var wrap = doc.querySelector('[id^="shopify-section-"]');
    if (wrap) {
      return wrap.querySelector('.product-recommendations');
    }
    var fallback = document.createElement('div');
    fallback.innerHTML = text;
    return fallback.querySelector('.product-recommendations');
  }

  function initLazyRecommendations(productRecommendationsSection) {
    if (!productRecommendationsSection || productRecommendationsSection.dataset.recommendationsInit === 'true') {
      return;
    }

    var url = productRecommendationsSection.dataset.url;
    if (!url) {
      return;
    }

    productRecommendationsSection.dataset.recommendationsInit = 'true';

    if (productRecommendationsSection.querySelector('[data-carousel-track]')) {
      bindRecommendationsCarousel(productRecommendationsSection);
    }

    var handleIntersection = function (entries, observer) {
      if (!entries[0].isIntersecting) {
        return;
      }
      observer.unobserve(productRecommendationsSection);

      fetch(url)
        .then(function (response) {
          return response.text();
        })
        .then(function (text) {
          var recommendations = parseRecommendationsFromResponse(text);

          if (recommendations && recommendations.innerHTML.trim().length > 0) {
            productRecommendationsSection.innerHTML = recommendations.innerHTML;
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                bindRecommendationsCarousel(productRecommendationsSection);
              });
            });
          } else {
            productRecommendationsSection.innerHTML = '';
          }
        })
        .catch(function (error) {
          console.error(error);
        });
    };

    var observer = new IntersectionObserver(handleIntersection, {
      rootMargin: '0px 0px 200px 0px',
    });

    observer.observe(productRecommendationsSection);
  }

  document.querySelectorAll('.recommendations-section .product-recommendations').forEach(function (el) {
    initLazyRecommendations(el);
  });
{% endjavascript %}

{% schema %}
  {
    "name": "Recommendations",
    "settings": [
      {
        "type": "range",
        "id": "limit",
        "min": 4,
        "max": 10,
        "step": 1,
        "default": 10,
        "label": "Number of recommendations",
        "info": "Shopify returns at most 10 related products."
      }
    ],
    "presets": [
      {
        "name": "Recommendations"
      }
    ]
  }
{% endschema %}
