<script>
  window.eventKeeper.onEventHeard('shopify:features:consent-tracking-api:ready', () => {

    const region = window?.Shopify?.customerPrivacy?.getRegion();

    if (!region) {
      return;
    }

    const [
      countryCode,
      provinceCode,
    ] = [region.slice(0, 2), region.slice(2)];

    document.dispatchEvent(new CustomEvent('geolocation:ready', {
      detail: { 
        countryCode,
        provinceCode,
      },
    }));
  });
</script>