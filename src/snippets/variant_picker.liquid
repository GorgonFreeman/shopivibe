{%- comment -%}
  Renders product option pickers (Size, Color, etc).

  Usage: {% render 'variant_picker', product: product %}
{%- endcomment -%}
{%- if product and product.has_only_default_variant == false -%}
  {%- assign selected_variant = product.selected_or_first_available_variant -%}
  <variant-picker data-rendered>
    <script type="application/json" data-ref="product">{{ product | json }}</script>
    {%- for option in product.options_with_values -%}
      <fieldset class="variant-picker__option">
        <legend class="variant-picker__option-name">{{ option.name }}</legend>
        <div class="variant-picker__values">
          {%- for value in option.values -%}
            {%- assign option_index = forloop.parentloop.index0 -%}
            {%- assign selected_value = selected_variant.options[option_index] -%}
            <button
              type="button"
              class="variant-picker__value"
              data-option-index="{{ option_index }}"
              data-option-value="{{ value }}"
              aria-pressed="{% if value == selected_value %}true{% else %}false{% endif %}"
            >
              {{ value }}
            </button>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
  </variant-picker>
{%- endif -%}
