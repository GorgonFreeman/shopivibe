{%- if product -%}
  <product-price>
    {%- if product.price_varies -%}
      <span class="product-price__from">{{ 'products.price_from' | t }}</span>
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}
      <s class="product-price__compare">{{ product.compare_at_price | money }}</s>
    {%- endif -%}
    <span class="product-price__current{% if product.compare_at_price > product.price %} sale{% endif %}">{{ product.price | money }}</span>
  </product-price>
{%- endif -%}
